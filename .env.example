# ==============================================================================
# SENSORIA: Environment Variables Setup (100% Free Tier)
# ==============================================================================

# ------------------------------------------------------------------------------
# OPSI UTAMA (SANGAT DIREKOMENDASIKAN): Supabase Free Tier (PostgreSQL)
# ------------------------------------------------------------------------------
# 1. Buat project gratis di https://supabase.com
# 2. Buka Project Settings -> API
# 3. Salin Project URL & anon public API key ke variabel di bawah ini:
# (Saat deploy ke Vercel, masukkan 2 variabel ini di Vercel Dashboard -> Settings -> Environment Variables)

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------------------------
# OPSI ALTERNATIF: Vercel Postgres / Neon Storage
# ------------------------------------------------------------------------------
# Jika Anda memilih membuat database langsung di Vercel Storage -> Postgres (Neon),
# variabel ini otomatis disediakan oleh sistem Vercel saat Anda Connect project:
# POSTGRES_URL=postgres://default:your-password@ep-example.region.aws.neon.tech:5432/verceldb?sslmode=require
# DATABASE_URL=postgres://default:your-password@ep-example.region.aws.neon.tech:5432/verceldb?sslmode=require
